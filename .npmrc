# reader-core is a git dependency (git+https://github.com/OlegG90/reader-core.git#<tag>).
# npm 12 refuses git dependencies unless allowed; "root": only this package's own.
# It still won't move an installed one to another tag, so a new tag goes in as
#   npm uninstall reader-core
#   npm install git+https://github.com/OlegG90/reader-core.git#vX.Y.Z
allow-git=root
