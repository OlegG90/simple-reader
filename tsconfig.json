{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    // reader-core ships foliate-js as JavaScript: read its types from there, as from src before.
    "maxNodeModuleJsDepth": 3,
    "skipLibCheck": true,
    "types": ["vite/client"]
  },
  "include": ["src"]
}
